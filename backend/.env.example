# Backend Environment Variables Example
# Duplicate this file to .env for local development

PORT=3001
NODE_ENV=development

# FRONTEND_URL is required for CORS configuration
# Development: http://localhost:3000
# Production: https://your-production-frontend.com
FRONTEND_URL=http://localhost:3000

# Database Configuration (DO NOT commit real production passwords)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=college_attendance
DB_CONNECTION_LIMIT=10

# Security (JWT secret MUST be a strong, randomly generated string in production)
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=1h

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
